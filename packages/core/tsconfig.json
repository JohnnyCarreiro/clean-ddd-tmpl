{
	"$schema": "https://json.schemastore.org/tsconfig",
	"display": "Node 20",
	"_version": "20.1.0",

	"compilerOptions": {
		"outDir": "./dist",
		"declaration": true,
		"declarationMap": true,
		"module": "ESNext",
		"target": "ESNext",
		"moduleResolution": "node",
		"esModuleInterop": true,
		"skipLibCheck": true,
		"strict": true,
		"baseUrl": ".",
		"paths": {
			"@/*": ["src/*"]
		},
		"types": ["vitest/globals"]
		// "types": ["vitest/globals", "types/**/*.d.ts"]
	},
	"include": ["src/**/*", "test/**/*", "*.ts", "types/**/*"],
	"exclude": ["node_modules", "./src/**/__internal__/**/*", "*.config.ts"]
}
